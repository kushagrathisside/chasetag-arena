  <diagram id="round-lifecycle" name="Page-1">
    <mxGraphModel dx="960" dy="460" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s_start" value="&lt;b&gt;Round start&lt;/b&gt;&lt;br&gt;Apply pending selectors&lt;br&gt;Reset the arena" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15191f;fillColor=#dae8fc;strokeColor=#1d5fa8;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s_running" value="&lt;b&gt;Running&lt;/b&gt;&lt;br&gt;Decisions every 0.1 s&lt;br&gt;of game time" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15191f;fillColor=#d5e8d4;strokeColor=#2d6a3e;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s_ended" value="&lt;b&gt;Ended&lt;/b&gt;&lt;br&gt;ended_by: tag, fall&lt;br&gt;or timeout&lt;br&gt;Frame shows round score" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15191f;fillColor=#e8dcf2;strokeColor=#6c4a8a;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s_inter" value="&lt;b&gt;Intermission&lt;/b&gt;&lt;br&gt;1.5 s of wall time&lt;br&gt;Score still shown" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15191f;fillColor=#f2f2f2;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="t1" value="first frame" style="html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#15191f;labelBackgroundColor=none;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_start" target="s_running"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="t2" value="tag, fall&lt;br&gt;or time-out" style="html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#15191f;labelBackgroundColor=none;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_running" target="s_ended"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-24"/></mxGeometry></mxCell>
        <mxCell id="t3" value="end frame" style="html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#15191f;labelBackgroundColor=none;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_ended" target="s_inter"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="t4" value="after 1.5 s" style="html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#15191f;labelBackgroundColor=none;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="s_inter" target="s_start"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="270"/><mxPoint x="110" y="270"/></Array><mxPoint as="offset" x="0" y="16"/></mxGeometry></mxCell>
        <mxCell id="n_selector" value="Selector changes wait in a pending slot and apply only at Round start. A round in progress never changes." style="rounded=1;html=1;fontSize=11;fillColor=#fff7e6;strokeColor=#b4520c;fontColor=#15191f;" vertex="1" parent="1"><mxGeometry x="30" y="318" width="1000" height="26" as="geometry"/></mxCell>
        <mxCell id="n_restart" value="Restart clears the match tally and starts a new round at once. Pause and speed change decisions, not the round." style="rounded=1;html=1;fontSize=11;fillColor=#fff7e6;strokeColor=#b4520c;fontColor=#15191f;" vertex="1" parent="1"><mxGeometry x="30" y="352" width="1000" height="26" as="geometry"/></mxCell>
