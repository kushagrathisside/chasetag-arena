        <mxCell id="n6_3" value="&lt;b&gt;6.3&lt;/b&gt; Write a tutorial: &quot;Your first body&quot;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#2d6a3e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="622.0" y="1240.0" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="n6_4" value="&lt;b&gt;6.4&lt;/b&gt; Write a tutorial: &quot;Your first bot&quot;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#2d6a3e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="622.0" y="1316.0" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="n6_5" value="&lt;b&gt;6.5&lt;/b&gt; Write a guide to playing from another device on the same network" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#2d6a3e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="622.0" y="1392.0" width="210" height="78" as="geometry"/></mxCell>
        <mxCell id="n6_6" value="&lt;b&gt;6.6&lt;/b&gt; Refresh the screenshots and record a short gameplay clip" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#2d6a3e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="622.0" y="1484.0" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="L7" value="" style="rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1594" width="1080.0" height="120" as="geometry"/></mxCell>
        <mxCell id="T7" value="&lt;b&gt;Epic 7&lt;/b&gt; · Testing and Quality (open epic)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#15191f;" vertex="1" parent="1"><mxGeometry x="54" y="1604" width="800" height="28" as="geometry"/></mxCell>
        <mxCell id="B7" value="There are no fixed tasks. There is one module issue for each part of the project (Simulator core and rules, Body models, Scripted bots, Game loop and controls, Game server and API, Browser page, Planners, League and training, Dataset tools, Research logging and contribution, Command line, Documentation and build). If you find a gap, open a sub-issue under the module issue and agree the scope with the maintainer first." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#15191f;" vertex="1" parent="1"><mxGeometry x="54" y="1636" width="1052.0" height="66" as="geometry"/></mxCell>
        <mxCell id="lg0" value="Can be taken at any time" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#2d6a3e;strokeWidth=1.5;arcSize=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1744" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="lg1" value="Start here: others follow it" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#1d5fa8;strokeWidth=1.5;arcSize=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="1744" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="lg2" value="Follows the issue before it" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15191f;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#6b7280;strokeWidth=1.5;arcSize=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1744" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="lga" style="html=1;strokeColor=#566573;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="654" y="1761" as="sourcePoint"/><mxPoint x="704" y="1761" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lgat" value="Must be merged first" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#15191f;" vertex="1" parent="1"><mxGeometry x="712" y="1749" width="130" height="24" as="geometry"/></mxCell>
