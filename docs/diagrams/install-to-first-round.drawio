        <mxCell id="s1" value="&lt;b&gt;1 Install uv&lt;/b&gt;&lt;br&gt;One time, from uv&#x27;s website" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#15191f;fillColor=#dae8fc;strokeColor=#1d5fa8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="150" height="100" as="geometry"/></mxCell>
